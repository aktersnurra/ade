#!/bin/sh
# Restore /workspace from a validated archive in a read-only import mount.
#
# Runs in a freshly created machine from the pinned image, so it is trusted only
# for this bounded operation.
#
# Usage: restore-workspace /mnt/ade-import

set -eu

source_dir="${1:?usage: restore-workspace SOURCE}"
archive="$source_dir/workspace.tar"
[ -f "$archive" ] || { echo "no archive at $archive" >&2; exit 1; }

mkdir -p /workspace

# Never follow an archive-provided symlink while creating later entries.
tar --extract \
    --file "$archive" \
    --directory /workspace \
    --no-overwrite-dir \
    --no-same-owner \
    --no-same-permissions

sync
echo "restored /workspace from $archive"
