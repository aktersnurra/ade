 pub use super::krun::KrunFunctions;
 use super::VmResources;
 
+/// Disable libkrun's implicit vsock before configuring an explicit one.
+///
+/// The libkrun revision smolvm pins still defaults `VsockConfig` to `Implicit`,
+/// and its `krun_add_vsock` returns `-EEXIST` unless the config is `Disabled`.
+/// Newer revisions dropped the implicit vsock along with this symbol, so its
+/// absence is not an error.
+fn disable_implicit_vsock(krun: &KrunFunctions, ctx: u32) {
+    if let Some(disable) = krun.disable_implicit_vsock {
+        let rc = unsafe { disable(ctx) };
+        if rc < 0 {
+            tracing::debug!(rc, "krun_disable_implicit_vsock returned an error; continuing");
+        }
+    }
+}
+
+
