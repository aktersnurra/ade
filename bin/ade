#!/usr/bin/env bash
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
ARTIFACT_DIR="${ADE_ARTIFACT_DIR:-$REPO_ROOT/artifacts}"
MANAGED_MSB="${XDG_DATA_HOME:-$HOME/.local/share}/ade/runtime/msb-0.6.10/bin/msb"
if [[ -z "${MSB_BIN:-}" && -x "$MANAGED_MSB" ]]; then
  MSB_BIN="$MANAGED_MSB"
else
  MSB_BIN="${MSB_BIN:-msb}"
fi

usage() {
  cat <<'EOF'
Usage:
  ade list
  ade build-image
  ade load-image [OCI_ARCHIVE]
  ade create PROFILE
  ade up PROFILE
  ade start PROFILE
  ade exec PROFILE -- COMMAND [ARG...]
  ade stream PROFILE -- COMMAND [ARG...]
  ade stop PROFILE [--force]
  ade restart PROFILE
  ade reimage PROFILE
  ade inspect PROFILE
  ade modify PROFILE -- MSB_MODIFY_ARGS...
  ade remove PROFILE
  ade profile PROFILE

Profiles are loaded from $ADE_PROFILE_DIR, then $XDG_CONFIG_HOME/ade/profiles,
then this repository's profiles directory. A profile is executable Bash
configuration and can use any Microsandbox create/modify option.
EOF
}

fail() { printf 'ade: %s\n' "$*" >&2; exit 1; }

profile_path() {
  local profile="$1" candidate
  local user_config="${XDG_CONFIG_HOME:-$HOME/.config}/ade/profiles"
  local candidates=()
  if [[ -n "${ADE_PROFILE_DIR:-}" ]]; then
    candidates+=("$ADE_PROFILE_DIR/$profile.sh")
  fi
  candidates+=("$user_config/$profile.sh" "$REPO_ROOT/profiles/$profile.sh")
  for candidate in "${candidates[@]}"; do
    [[ -f "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}

add_secret_if_set() {
  local variable="$1" hosts="$2"
  if [[ -n "${!variable:-}" ]]; then
    SECRET_SPECS+=("$variable@$hosts")
  fi
}

load_profile() {
  local requested="$1" path
  # A profile name is one path segment. Anything else could escape the profile
  # directories and source arbitrary host code.
  [[ "$requested" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
    fail "invalid profile name: $requested"
  path="$(profile_path "$requested")" || fail "unknown profile: $requested"

  PROFILE_NAME="$requested"
  SANDBOX_NAME="ade-$requested"
  IMAGE="ade-nix-workstation:0.1.0"
  EXPECTED_IMAGE_DIGEST=""
  CPUS=4
  MEMORY="8G"
  ROOT_DISK="24G"
  WORKDIR="/workspace"
  PULL_POLICY="never"
  EXEC_TIMEOUT="30m"
  REIMAGE_STATE="running"
  CREDENTIAL_ENV_FILE=""
  PERSIST_DIRS=()
  MOUNTS=()
  NETWORK_ARGS=()
  SECRET_SPECS=()
  REQUIRED_SECRETS=()
  ENV_ARGS=()
  EXTRA_CREATE_ARGS=()
  DEFAULT_SHELL=()

  # shellcheck source=/dev/null
  source "$path"

  : "${PROFILE_HOME:=${XDG_DATA_HOME:-$HOME/.local/share}/ade/workbenches/$PROFILE_NAME}"
  : "${SANDBOX_NAME:=ade-$PROFILE_NAME}"
  [[ ${#DEFAULT_SHELL[@]} -gt 0 ]] || DEFAULT_SHELL=(/bin/bash -l)

  # Source without implicitly exporting every assignment. A custom profile may
  # deliberately export values required by native Microsandbox secret handling;
  # the checked-in profiles forward no ambient credential by default.
  if [[ -n "$CREDENTIAL_ENV_FILE" && -f "$CREDENTIAL_ENV_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CREDENTIAL_ENV_FILE"
  fi
  if declare -F load_credentials >/dev/null; then load_credentials; fi
  if declare -F configure_credentials >/dev/null; then configure_credentials; fi

  local variable
  for variable in "${REQUIRED_SECRETS[@]}"; do
    [[ -n "${!variable:-}" ]] || fail "required secret environment variable is unset: $variable"
  done
}

check_msb() {
  local version
  version="$($MSB_BIN --version)" || fail "cannot execute $MSB_BIN"
  [[ "$version" == "msb 0.6.10" ]] || fail "expected msb 0.6.10, got: $version"
}

# A failing "msb list" must not be reported as an absent sandbox; capture the
# listing first so a runtime fault aborts instead of masquerading as absence.
sandbox_exists() {
  local listing
  listing="$("$MSB_BIN" list --quiet)" || fail "cannot list sandboxes"
  grep -Fxq "$SANDBOX_NAME" <<<"$listing"
}
sandbox_running() {
  local listing
  listing="$("$MSB_BIN" list --running --quiet)" || fail "cannot list running sandboxes"
  grep -Fxq "$SANDBOX_NAME" <<<"$listing"
}

verify_image() {
  [[ -n "$EXPECTED_IMAGE_DIGEST" ]] || return 0
  local inspection actual
  inspection="$($MSB_BIN image inspect --format json "$IMAGE")" || \
    fail "cannot inspect image: $IMAGE"
  actual="$(python3 -c 'import json, sys; print(json.load(sys.stdin)["digest"])' <<<"$inspection")" || \
    fail "cannot read image digest: $IMAGE"
  [[ "$actual" == "$EXPECTED_IMAGE_DIGEST" ]] || \
    fail "image digest mismatch for $IMAGE: expected $EXPECTED_IMAGE_DIGEST, got $actual"
}

prepare_profile() {
  local directory mount host
  verify_image
  for directory in "${PERSIST_DIRS[@]}"; do mkdir -p "$directory"; done
  for mount in "${MOUNTS[@]}"; do
    host="${mount%%:*}"
    [[ -e "$host" ]] || fail "mount source does not exist: $host"
  done
}

create_sandbox() {
  prepare_profile
  local args=(
    create --name "$SANDBOX_NAME"
    --cpus "$CPUS" --memory "$MEMORY" --root-disk "$ROOT_DISK"
    --workdir "$WORKDIR" --pull "$PULL_POLICY"
  )
  local mount secret value
  for mount in "${MOUNTS[@]}"; do args+=(--mount-dir "$mount"); done
  args+=("${NETWORK_ARGS[@]}")
  for secret in "${SECRET_SPECS[@]}"; do args+=(--secret "$secret"); done
  for value in "${ENV_ARGS[@]}"; do args+=(-e "$value"); done
  args+=("${EXTRA_CREATE_ARGS[@]}")
  args+=("$IMAGE")
  "$MSB_BIN" "${args[@]}"
}

ensure_created() { sandbox_exists || create_sandbox; }
ensure_running() {
  ensure_created
  sandbox_running || "$MSB_BIN" start "$SANDBOX_NAME"
}

command="${1:-}"
case "$command" in
  list)
    check_msb
    exec "$MSB_BIN" list
    ;;
  build-image)
    if [[ "$(uname -s)" == Darwin ]]; then
      exec "$REPO_ROOT/scripts/build-linux-image.sh"
    fi
    mkdir -p "$ARTIFACT_DIR"
    nix build "$REPO_ROOT/images/nix-workstation#packages.aarch64-linux.workstation" \
      --out-link "$ARTIFACT_DIR/ade-nix-workstation-0.1.0.tar.gz"
    gzip -dc "$ARTIFACT_DIR/ade-nix-workstation-0.1.0.tar.gz" \
      >"$ARTIFACT_DIR/ade-nix-workstation-0.1.0.tar"
    printf 'image=%s\n' "$ARTIFACT_DIR/ade-nix-workstation-0.1.0.tar"
    ;;
  load-image)
    check_msb
    archive="${2:-$ARTIFACT_DIR/ade-nix-workstation-0.1.0.tar}"
    exec "$MSB_BIN" image load --input "$archive"
    ;;
  create|up|start|exec|stream|stop|restart|reimage|inspect|modify|remove|profile)
    profile="${2:-}"
    [[ -n "$profile" ]] || { usage >&2; exit 2; }
    load_profile "$profile"
    check_msb
    case "$command" in
      create)
        sandbox_exists && fail "sandbox already exists: $SANDBOX_NAME"
        create_sandbox
        ;;
      up)
        ensure_running
        ;;
      start)
        ensure_running
        exec "$MSB_BIN" exec --tty "$SANDBOX_NAME" -- "${DEFAULT_SHELL[@]}"
        ;;
      exec)
        shift 2; [[ "${1:-}" == "--" ]] && shift
        [[ $# -gt 0 ]] || fail "exec requires a command"
        ensure_running
        exec "$MSB_BIN" exec --no-tty --timeout "$EXEC_TIMEOUT" "$SANDBOX_NAME" -- "$@"
        ;;
      stream)
        shift 2; [[ "${1:-}" == "--" ]] && shift
        [[ $# -gt 0 ]] || fail "stream requires a command"
        ensure_running
        exec "$MSB_BIN" exec --stream --timeout "$EXEC_TIMEOUT" "$SANDBOX_NAME" -- "$@"
        ;;
      stop)
        force="${3:-}"
        sandbox_exists || fail "sandbox does not exist: $SANDBOX_NAME"
        if [[ "$force" == "--force" ]]; then exec "$MSB_BIN" stop --force "$SANDBOX_NAME"; fi
        exec "$MSB_BIN" stop "$SANDBOX_NAME"
        ;;
      restart)
        if sandbox_exists; then "$MSB_BIN" stop "$SANDBOX_NAME" || true; fi
        ensure_running
        ;;
      reimage)
        # Complete image and mount preflight before destroying the existing VM.
        prepare_profile
        if sandbox_exists; then
          "$MSB_BIN" stop "$SANDBOX_NAME" >/dev/null 2>&1 || true
          "$MSB_BIN" remove "$SANDBOX_NAME"
        fi
        create_sandbox
        if [[ "$REIMAGE_STATE" == "stopped" ]]; then
          "$MSB_BIN" stop "$SANDBOX_NAME"
        fi
        ;;
      inspect)
        exec "$MSB_BIN" inspect --format json "$SANDBOX_NAME"
        ;;
      modify)
        shift 2; [[ "${1:-}" == "--" ]] && shift
        exec "$MSB_BIN" modify "$SANDBOX_NAME" "$@"
        ;;
      remove)
        sandbox_exists || fail "sandbox does not exist: $SANDBOX_NAME"
        "$MSB_BIN" stop "$SANDBOX_NAME" >/dev/null 2>&1 || true
        exec "$MSB_BIN" remove "$SANDBOX_NAME"
        ;;
      profile)
        printf 'profile=%s\nsandbox=%s\nimage=%s\nprofile_home=%s\n' \
          "$PROFILE_NAME" "$SANDBOX_NAME" "$IMAGE" "$PROFILE_HOME"
        printf 'mount=%s\n' "${MOUNTS[@]}"
        printf 'network_arg=%s\n' "${NETWORK_ARGS[@]}"
        printf 'secret=%s\n' "${SECRET_SPECS[@]}"
        ;;
    esac
    ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
