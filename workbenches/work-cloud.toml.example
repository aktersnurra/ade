# Example cloud workbench.
#
# Copy to work-cloud.toml and replace the placeholder endpoints with the ones
# your own cloud workflow requires. This example intentionally contains no
# account identifiers, project names, or secrets.

name = "work-cloud"
image = "docker.io/menci/archlinuxarm:base-devel"
provision = "../provision/arch.sh"

[resources]
cpus = 4
memory_mib = 8192
overlay_gib = 32
workspace_gib = 128

[network]
posture = "allowlisted"
hosts = [
  "github.com",
  "api.github.com",
  "kubernetes.default.svc",
  "REPLACE-ME.example.com",
  # Arch mirrors, the Herdr and Claude Code installers, and the agent API.
  "geo.mirror.pkgbuild.com",
  "mirror.archlinuxarm.org",
  "herdr.dev",
  "release-assets.githubusercontent.com",
  "claude.ai",
  "downloads.claude.ai",
  "api.anthropic.com",
]
cidrs = []

[services]
herdr = true

[ssh]
mode = "dedicated_agent"
key_ref = "keychain:ade-work-cloud-ssh"
