# Example cloud workbench.
#
# Copy to work-cloud.toml and replace the placeholder endpoints with the ones
# your own cloud workflow requires. This example intentionally contains no
# account identifiers, project names, or secrets.

name = "work-cloud"
image = "file:/Users/aktersnurra/projects/vibe/gatekeep.workspaces/transport-qualification/artifacts/ade-nix-workstation-0.1.0.tar@sha256:d8db3517d2c8c667b130531741dfbf7a3e71a508442465c585af27de1b0e9234"
smolfile = "smolfiles/workstation.Smolfile"

[resources]
cpus = 4
memory_mib = 8192
overlay_gib = 32
workspace_gib = 128

[network]
posture = "allowlisted"
hosts = [
  "github.com",
  "api.github.com",
  "kubernetes.default.svc",
  "REPLACE-ME.example.com",
]
cidrs = []

[services]
docker = true
herdr = true

[ssh]
mode = "dedicated_agent"
key_ref = "keychain:ade-work-cloud-ssh"

[backup]
directory = "~/ade-backups/work-cloud"
keep = 3
