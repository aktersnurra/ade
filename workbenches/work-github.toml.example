# Example: a work workbench with GitHub App credentials.
#
# Copy to work.toml's [credentials.github] table and fill in your own values.
# This file contains no real identifiers.
#
# Creating the App. The form has around forty permission dropdowns; three of
# them matter and everything else stays on "No access".
#
# GitHub -> Settings -> Developer settings -> GitHub Apps -> New GitHub App
#
#   Name                  anything globally unique, e.g. ade-work
#   Homepage URL          required by the form, never fetched. Your GitHub
#                         profile URL is fine.
#   Callback URL          leave blank. It is only for OAuth user
#                         authorization, which ADE does not use.
#   Webhook               uncheck "Active". Otherwise GitHub POSTs events at an
#                         endpoint that does not exist and the App's settings
#                         page fills with delivery failures.
#
#   Repository permissions:
#     Contents            Read and write   -- read files, push commits
#     Pull requests       Read and write   -- open and update PRs
#     Metadata            Read-only        -- selected automatically, mandatory
#
#   Leave Actions, Issues, Packages, Administration and the rest at "No
#   access". Widening later is one dropdown; discovering you over-granted is a
#   security review.
#
#   Where can this App be installed?   Only on this account
#
# Then Install App -> Only select repositories. Start with one low-stakes
# repository; more can be added to the installation later without touching the
# App itself.
#
# Afterwards:
#   App ID           on the App's General tab
#   Installation ID  the trailing number in the URL once installed
#   Private key      "Generate a private key" at the bottom of General; keep
#                    the .pem outside this repository
#
# What you grant here is held by every agent in this workbench: a workbench is
# one security principal, with no isolation between the agents inside it. So
# which repositories are installed matters more than the permission list.

name = "work"
image = "ade-nix-workstation@sha256:d8db3517d2c8c667b130531741dfbf7a3e71a508442465c585af27de1b0e9234"
smolfile = "smolfiles/workstation.Smolfile"

[resources]
cpus = 6
memory_mib = 12288
overlay_gib = 32
workspace_gib = 256

[network]
posture = "allowlisted"
hosts = [
  "github.com",
  "api.github.com",
  "codeload.github.com",
  "objects.githubusercontent.com",
]
cidrs = []

[services]
docker = true
herdr = true

[ssh]
mode = "dedicated_agent"
key_ref = "keychain:ade-work-ssh"

[backup]
directory = "~/ade-backups/work"
keep = 5

[credentials.github]
app_id = "REPLACE-WITH-APP-ID"
installation_id = "REPLACE-WITH-INSTALLATION-ID"

# The key stays on the host and never enters the guest; only the derived,
# one-hour installation token is installed into guest tmpfs.
private_key_path = "~/.config/ade/REPLACE-WITH-KEY-NAME.pem"

# Required. Without it the token would reach every repository the App is
# installed on.
repositories = [
  "REPLACE-ME/first-repo",
  "REPLACE-ME/second-repo",
]

# Required. Without it the token would carry the App's full installation
# authority.
[credentials.github.permissions]
contents = "write"
pull_requests = "write"
