opam-version: "2.0"
name: "ade"
version: "0.1.0"
synopsis: "Manage local agent workbench VMs"
maintainer: "gustaf.rydholm@gmail.com"
authors: "Gustaf Rydholm"
license: "MIT"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.21"}
  "cmdliner" {>= "2.1.1"}
  "otoml" {>= "1.0.5"}
  "yojson" {>= "3.0.0"}
  "digestif" {>= "1.3.0"}
  "bos"
  "rresult"
  "alcotest" {with-test & >= "1.9.1"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
